clc;
clear;
close all;

% Link Length
l1 = 1;
l2 = 0.8;

% Joint Angles
theta1 = 45 * pi/180;
theta2 = 30 * pi/180;

% Base Position
x0 = 0;
y0 = 0;

% Joint 1 Position
x1 = l1 * cos(theta1);
y1 = l1 * sin(theta1);

% End Effector Position
x2 = x1 + l2 * cos(theta1 + theta2);
y2 = y1 + l2 * sin(theta1 + theta2);

% Display End Effector Position
fprintf('End Effector Position:\n');
fprintf('X = %.3f\n', x2);
fprintf('Y = %.3f\n', y2);

% Draw Robot
figure;

plot([x0 x1 x2], [y0 y1 y2], '-o', ...
    'LineWidth', 4, ...
    'MarkerSize', 10);

grid on;
axis equal;

xlim([-2 2]);
ylim([-2 2]);

xlabel('X Position');
ylabel('Y Position');

title('2-Link Robot Manipulator - Forward Kinematics');
